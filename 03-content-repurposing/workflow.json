    {
      "parameters": {
        "jsShortcuts": false,
        "language": "javaScript",
        "jsCode": "// Collect the four channel drafts, tag each by channel, and run a\n// simple banned-keyword brand-safety check across all variants.\nconst banned = [\n  'guaranteed', 'get rich', 'miracle', 'risk-free', 'no risk',\n  'act now', 'limited time only', 'crypto pump', 'financial advice'\n];\n\nconst channels = ['linkedin', 'x_thread', 'newsletter', 'video_captions'];\nconst items = $input.all();\n\nconst variants = items.map((it, i) => {\n  const j = it.json || {};\n  // The OpenAI node returns the text under different keys depending on version;\n  // grab the most likely one.\n  const text = j.message?.content ?? j.content ?? j.text ?? j.output ?? JSON.stringify(j);\n  return { channel: channels[i] || `channel_${i}`, text };\n});\n\nconst blob = variants.map(v => v.text).join('\\n').toLowerCase();\nconst flagged = banned.filter(b => blob.includes(b));\n\nreturn [{\n  json: {\n    source_file: $('New Recording (Drive)').first().json.name || 'unknown',\n    title: $('AI Agent - Extract Content Atoms').first().json.output?.title || '',\n    variants,\n    brand_safe: flagged.length === 0,\n    flagged_terms: flagged,\n    created_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "brand-safety",
      "name": "Brand-Safety Sanitizer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2020, 140]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
