              "id": "cond-brandsafe",
              "leftValue": "={{ $json.brand_safe }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-brandsafe",
      "name": "Brand-Safe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2260, 140]
    },
