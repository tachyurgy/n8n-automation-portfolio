      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following transcript and extract reusable content atoms.\n\nSource file: {{ $('New Recording (Drive)').item.json.name }}\n\nTRANSCRIPT:\n{{ $json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a content strategist. Read a long-form transcript (podcast, webinar, or blog) and distill it into structured, reusable content atoms: a one-paragraph summary, the 3-5 core themes, the best verbatim pull-quotes, key statistics or claims, and a suggested title. Be faithful to the source; never invent facts, quotes, or numbers that are not present. Return ONLY the structured object defined by the output parser."
        }
      },
