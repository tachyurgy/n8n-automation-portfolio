    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a B2B sales development analyst. Score this inbound lead against our Ideal Customer Profile (ICP).\n\nICP (target): B2B SaaS or e-commerce companies, 50-2000 employees, using Shopify/Rails/modern web stacks, in North America or EU, with a VP/Director/Founder-level contact. Disqualifiers: students, personal gmail-only with no company, competitors, employee count < 10.\n\nLead:\n- Name: {{ $json.fullName }}\n- Email: {{ $json.email }}\n- Company: {{ $json.company }}\n- Domain: {{ $json.domain }}\n- Source: {{ $json.source }}\n\nEnrichment (firmographics):\n- Company name: {{ $('Enrich Company (self-hosted microservice)').item.json.company_name }}\n- Industry: {{ $('Enrich Company (self-hosted microservice)').item.json.industry }}\n- Employees: {{ $('Enrich Company (self-hosted microservice)').item.json.employee_count }}\n- Revenue: {{ $('Enrich Company (self-hosted microservice)').item.json.estimated_revenue }}\n- Tech stack: {{ $('Enrich Company (self-hosted microservice)').item.json.tech_stack }}\n- Country: {{ $('Enrich Company (self-hosted microservice)').item.json.country }}\n- Title: {{ $('Enrich Company (self-hosted microservice)').item.json.person_title }}\n\nReturn ONLY the structured object: a score 0-100, a tier (hot >=75, warm 40-74, cold <40), and one or two sentences of reasoning.",
        "hasOutputParser": true,
        "options": {}
      },
      "id": "04e1bef6-612c-4f5d-b1ff-7728771cb709",
      "name": "Score Lead Against ICP",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        60,
        320
      ]
    },
    {
      "parameters": {
        "model": {
