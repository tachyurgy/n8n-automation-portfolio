    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"score\": {\n      \"type\": \"integer\",\n      \"description\": \"ICP fit 0-100\"\n    },\n    \"tier\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"hot\",\n        \"warm\",\n        \"cold\"\n      ]\n    },\n    \"reasoning\": {\n      \"type\": \"string\",\n      \"description\": \"1-2 sentence justification\"\n    }\n  },\n  \"required\": [\n    \"score\",\n    \"tier\",\n    \"reasoning\"\n  ]\n}"
      },
      "id": "4c819265-f97f-4cfb-b293-7e6a59ae0ce9",
      "name": "ICP Score Parser (structured JSON)",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
